# Copy this file to .env and fill in values before running FalseFront

# Flask secret key — MUST be changed in production
FALSEFRONT_SECRET_KEY=change-me-to-a-long-random-string

# Anthropic API key — required for AI-powered attacker profiling
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Set to "development" to enable Flask debug mode
APP_ENV=production
