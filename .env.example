# Example environment variables for FalseFront.
# `python app.py` automatically loads a `.env` file via python-dotenv.
# Copy this file to `.env` and fill in your values before running.

# Flask secret key — MUST be changed in production
FALSEFRONT_SECRET_KEY=change-me-to-a-long-random-string

# Anthropic API key — required for AI-powered attacker profiling
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Set to "development" to enable Flask debug mode and allow missing SECRET_KEY
APP_ENV=production
